diff --git a/docker/harnesses/tether/Dockerfile b/docker/harnesses/tether/Dockerfile
new file mode 100644
index 0000000..d9f3e28
--- /dev/null
+++ b/docker/harnesses/tether/Dockerfile
@@ -0,0 +1,45 @@
+FROM python:3.12-slim-bookworm@sha256:d50fb7611f86d04a3b0471b46d7557818d88983fc3136726336b2a4c657aa30b AS task-toolchain
+
+ARG PIP_INDEX_URL
+ARG PIP_EXTRA_INDEX_URL
+ARG PIP_TRUSTED_HOST
+COPY docker/openclaw/requirements.lock /tmp/harnessbench-requirements.lock
+RUN python -m pip install --disable-pip-version-check --no-cache-dir \
+      --requirement /tmp/harnessbench-requirements.lock \
+    && rm /tmp/harnessbench-requirements.lock
+
+FROM python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de
+
+ARG TETHER_VERSION=0.2.5
+ARG PYPI_INDEX_URL=https://pypi.org/simple
+RUN apt-get update \
+    && apt-get install -y --no-install-recommends bash git ripgrep sqlite3 \
+    && rm -rf /var/lib/apt/lists/*
+
+
+
+RUN useradd --create-home --uid 1000 harness
+COPY --from=task-toolchain /usr/local/ /usr/local/
+COPY docker/openclaw/verify_toolchain.py /opt/harnessbench/verify_toolchain.py
+COPY docker/harnesses/tether/entrypoint.sh /opt/harness/bin/run
+RUN ln -sf /usr/local/bin/python3 /usr/bin/python3 \
+    && python /opt/harnessbench/verify_toolchain.py --python-only \
+    && python -m venv /opt/tether \
+    && /opt/tether/bin/python -m pip install --no-cache-dir \
+        --index-url "${PYPI_INDEX_URL}" "tether-sdk==${TETHER_VERSION}" \
+    && chmod 0755 /opt/harness/bin/run
+
+ENV PATH="/opt/harnessbench/frontend-bin:/usr/local/bin:/opt/tether/bin:${PATH}" \
+    NANOBOT_STREAM_IDLE_TIMEOUT_S=7200 \
+    NANOBOT_OPENAI_COMPAT_TIMEOUT_S=7200 \
+    NANOBOT_LLM_TIMEOUT_S=0
+
+# BEGIN NANOBOT LOGIN-SHELL PATH
+RUN printf '%s\n' \
+    'export PATH="/usr/local/bin:/opt/tether/bin:$PATH"' \
+    > /etc/profile.d/harnessbench-path.sh \
+    && chmod 0644 /etc/profile.d/harnessbench-path.sh
+# END NANOBOT LOGIN-SHELL PATH
+
+USER 1000:1000
+ENTRYPOINT ["/opt/harness/bin/run"]
diff --git a/docker/harnesses/tether/entrypoint.sh b/docker/harnesses/tether/entrypoint.sh
new file mode 100644
index 0000000..105cee6
--- /dev/null
+++ b/docker/harnesses/tether/entrypoint.sh
@@ -0,0 +1,38 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+: "${HARNESSBENCH_PROMPT:?}"
+: "${HARNESSBENCH_CONFIG:?}"
+: "${HARNESSBENCH_WORKSPACE:?}"
+: "${HARNESSBENCH_STATE:?}"
+: "${HARNESSBENCH_TRACE:?}"
+
+export HOME="${HARNESSBENCH_STATE}/home"
+mkdir -p "${HOME}" "${HARNESSBENCH_TRACE}"
+runtime_config="${HARNESSBENCH_STATE}/providers.yaml"
+cp "${HARNESSBENCH_CONFIG}" "${runtime_config}"
+# The render step writes `# model: <id>` and `# turns: <n>` on the first lines.
+model="$(sed -n 's/^# model: //p' "${runtime_config}" | head -1)"
+turns="$(sed -n 's/^# turns: //p' "${runtime_config}" | head -1)"
+prompt="$(<"${HARNESSBENCH_PROMPT}")"
+
+export TETHER_PROVIDERS="${runtime_config}"
+export VLLM_API_KEY="${VLLM_API_KEY:-local-vllm-no-auth}"   # placeholder; the trial proxy injects the real key
+export TETHER_DB="${HARNESSBENCH_STATE}/tether.db"   # state stays outside the graded workspace
+export TETHER_ENV_PASSTHROUGH="PATH,NODE_PATH,GIT_CONFIG_GLOBAL"
+
+set +e
+cd "${HARNESSBENCH_WORKSPACE}"
+tether run \
+  --model "harnessbench/${model}" \
+  --tools bash,edit \
+  --max-steps "${turns:-150}" \
+  "${prompt}" \
+  > >(tee "${HARNESSBENCH_TRACE}/events.log") \
+  2> >(tee "${HARNESSBENCH_TRACE}/stderr.log" >&2)
+status=$?
+set -e
+
+[[ -f "${TETHER_DB}" ]] && cp "${TETHER_DB}" "${HARNESSBENCH_TRACE}/tether.db"
+chmod -R a+rX "${HARNESSBENCH_WORKSPACE}" "${HARNESSBENCH_TRACE}" 2>/dev/null || true
+exit "${status}"
